{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Sub Reader: from subtitles to speech",
    "locale": "en",
    "output": "sub-reader.html",
    "quality_profile": "showcase",
    "viewBox": [1200, 570],
    "views": [
      { "id": "soft-subs", "label": "Soft subtitles", "focus": ["player", "tracks", "dom", "emit", "queue", "tts"], "note": "Text tracks and caption DOM already carry text, so they go straight to the speech queue." },
      { "id": "ocr-path", "label": "OCR for hard subtitles", "focus": ["player", "ocrcap", "bg", "offscreen", "tess", "emit"], "note": "Frames become a text mask in the tab; Tesseract runs in the offscreen document and the lines come back as the reply." },
      { "id": "settings", "label": "Settings", "focus": ["popup", "storage", "queue"], "note": "Popup and hotkey only write storage; every content script reacts to the change." }
    ]
  },
  "components": [
    { "id": "player", "type": "frontend", "label": "Video player", "sublabel": "<video> + caption DOM", "pos": [40, 210], "size": [160, 60] },
    { "id": "tracks", "type": "backend", "label": "textTracks source", "sublabel": "any .vtt player", "pos": [280, 100], "size": [160, 60] },
    { "id": "dom", "type": "backend", "label": "DOM source", "sublabel": "YouTube, Netflix, picked", "pos": [280, 210], "size": [160, 60] },
    { "id": "ocrcap", "type": "backend", "label": "OCR capture", "sublabel": "canvas -> text mask", "pos": [280, 320], "size": [160, 60], "tag": "every 300 ms" },
    { "id": "emit", "type": "backend", "label": "Clean + dedupe", "sublabel": "emit()", "pos": [520, 210], "size": [160, 60] },
    { "id": "queue", "type": "backend", "label": "Speech queue", "sublabel": "rate fit + ducking", "pos": [760, 210], "size": [160, 60] },
    { "id": "tts", "type": "external", "label": "speechSynthesis", "sublabel": "Edge Natural voice", "pos": [1000, 210], "size": [160, 60] },
    { "id": "storage", "type": "database", "label": "chrome.storage", "sublabel": "settings, ocrSites", "pos": [1000, 340], "size": [160, 60] },
    { "id": "bg", "type": "backend", "label": "background.js", "sublabel": "service worker relay", "pos": [280, 470], "size": [160, 60] },
    { "id": "offscreen", "type": "backend", "label": "offscreen.html", "sublabel": "ocr-engine.js", "pos": [520, 470], "size": [160, 60] },
    { "id": "tess", "type": "external", "label": "Tesseract worker", "sublabel": "WASM + vie model", "pos": [760, 470], "size": [160, 60] },
    { "id": "popup", "type": "frontend", "label": "Popup + hotkey", "sublabel": "Alt+Shift+R", "pos": [1000, 470], "size": [160, 60] }
  ],
  "boundaries": [
    { "kind": "region", "label": "content.js, inside each video tab", "wraps": ["tracks", "dom", "ocrcap", "emit", "queue"] },
    { "kind": "region", "label": "Extension", "wraps": ["bg", "offscreen", "tess", "popup"] }
  ],
  "connections": [
    { "id": "cue-change", "from": "player", "to": "tracks", "label": "cuechange", "fromSide": "top" },
    { "id": "caption-mutations", "from": "player", "to": "dom", "label": "mutations", "variant": "emphasis" },
    { "id": "video-frames", "from": "player", "to": "ocrcap", "label": "frames" },
    { "id": "cue-text", "from": "tracks", "to": "emit" },
    { "id": "new-words", "from": "dom", "to": "emit", "variant": "emphasis" },
    { "id": "ocr-lines", "from": "ocrcap", "to": "emit" },
    { "id": "say", "from": "emit", "to": "queue", "variant": "emphasis" },
    { "id": "speak", "from": "queue", "to": "tts", "label": "speak()", "variant": "emphasis" },
    { "id": "ocr-request", "from": "ocrcap", "to": "bg", "label": "sendMessage(PNG)", "labelAt": [360, 425] },
    { "id": "relay", "from": "bg", "to": "offscreen", "label": "relay" },
    { "id": "recognize", "from": "offscreen", "to": "tess", "label": "recognize" },
    { "id": "save-settings", "from": "popup", "to": "storage", "label": "set" },
    { "id": "settings-changed", "from": "storage", "to": "queue", "label": "onChanged", "variant": "dashed" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Three sources", "items": ["textTracks: standard .vtt cues", "DOM: YouTube, Netflix or a picked element", "OCR: hard subs; on by default for motchill"] },
    { "dot": "emerald", "title": "OCR round trip", "items": ["Light blobs walled in by a dark outline", "Tesseract.js in an offscreen document", "Lines under 60% confidence are dropped"] },
    { "dot": "amber", "title": "Speech", "items": ["Current line always finishes", "Movie volume ducked while speaking", "Pause or seek stops speech"] }
  ]
}
