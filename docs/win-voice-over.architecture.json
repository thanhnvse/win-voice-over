      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "tess",
      "type": "external",
      "label": "Tesseract worker",
      "sublabel": "WASM + vie model",
      "pos": [
        760,
        470
      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "popup",
      "type": "frontend",
      "label": "Popup + hotkey",
      "sublabel": "Alt+Shift+R",
      "pos": [
        1000,
        470
      ],
      "size": [
        160,
        60
      ]
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "content.js, inside each video tab",
      "wraps": [
        "tracks",
        "dom",
        "ocrcap",
        "emit",
        "queue"
      ]
    },
    {
      "kind": "region",
      "label": "Extension",
      "wraps": [
        "bg",
        "offscreen",
        "tess",
        "popup"
      ]
    }
  ],
  "connections": [
    {
      "id": "cue-change",
      "from": "player",
      "to": "tracks",
      "label": "cuechange",
      "fromSide": "top"
    },
    {
      "id": "caption-mutations",
      "from": "player",
      "to": "dom",
      "label": "mutations",
      "variant": "emphasis"
    },
    {
      "id": "video-frames",
      "from": "player",
      "to": "ocrcap",
      "label": "frames"
    },
    {
      "id": "cue-text",
      "from": "tracks",
      "to": "emit"
    },
    {
      "id": "new-words",
      "from": "dom",
      "to": "emit",
      "variant": "emphasis"
    },
    {
      "id": "ocr-lines",
      "from": "ocrcap",
      "to": "emit"
    },
    {
      "id": "say",
      "from": "emit",
      "to": "queue",
      "variant": "emphasis"
    },
    {
      "id": "speak",
      "from": "queue",
      "to": "tts",
      "label": "speak()",
      "variant": "emphasis"
    },
    {
      "id": "gemini-speech",
      "from": "queue",
      "to": "gemini",
      "label": "WAV via background.js",
      "fromSide": "top",
      "variant": "dashed"
    },
    {
      "id": "ocr-request",
      "from": "ocrcap",
      "to": "bg",
      "label": "sendMessage(PNG)",
      "labelAt": [
        360,
        425
      ]
    },
    {
      "id": "relay",
      "from": "bg",
      "to": "offscreen",
      "label": "relay"
    },
    {
      "id": "recognize",
      "from": "offscreen",
      "to": "tess",
      "label": "recognize"
    },
    {
      "id": "save-settings",
      "from": "popup",
      "to": "storage",
      "label": "set"
    },
    {
      "id": "settings-changed",
      "from": "storage",
      "to": "queue",
      "label": "onChanged",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Three sources",
      "items": [
        "textTracks: standard .vtt cues",
        "DOM: YouTube, Netflix or a picked element",
        "OCR: hard subs; on by default for motchill"
      ]
    },
    {
      "dot": "emerald",
      "title": "OCR round trip",
      "items": [
        "Light blobs walled in by a dark outline",
        "Tesseract.js in an offscreen document",
        "Lines under 60% confidence are dropped"
      ]
    },
    {
      "dot": "amber",
      "title": "Speech",
      "items": [
        "Browser voice, or Gemini TTS with a key",
        "Current line always finishes",
        "Movie volume ducked while speaking"
      ]
    }
  ]
}
