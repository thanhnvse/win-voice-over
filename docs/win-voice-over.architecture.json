{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Win Voice Over: from subtitles to speech",
    "locale": "en",
    "output": "win-voice-over.html",
    "quality_profile": "showcase",
    "viewBox": [
      1200,
      630
    ],
    "views": [
      {
        "id": "soft-subs",
        "label": "Soft subtitles",
        "focus": [
          "player",
          "tracks",
          "dom",
          "emit",
          "queue",
          "tts"
        ],
        "note": "Text tracks and caption DOM already carry text, so they go straight to the speech queue."
      },
      {
        "id": "ocr-path",
        "label": "OCR for hard subtitles",
        "focus": [
          "player",
          "ocrcap",
          "bg",
          "offscreen",
          "tess",
          "emit"
        ],
        "note": "Frames become a text mask in the tab; Tesseract runs in the offscreen document and the lines come back as the reply."
      },
      {
        "id": "settings",
        "label": "Settings",
        "focus": [
          "popup",
          "storage",
          "queue"
        ],
        "note": "Popup and hotkey only write storage; every content script reacts to the change."
      },
      {
        "id": "voices",
        "label": "Voices",
        "focus": [
          "queue",
          "tts",
          "bg",
          "cloudtts",
          "vieneu"
        ],
        "note": "Browser voice by default. background.js calls Gemini, Azure or VieNeu, so keys stay out of the page; a failed line uses the browser voice."
      },
      {
        "id": "vieneu-local",
        "label": "VieNeu on this computer",
        "focus": [
          "app",
          "vieneu",
          "bg"
        ],
        "note": "win-voice-over.app (macOS) or start-vieneu.cmd (Windows) runs the VieNeu-TTS server on 127.0.0.1:8000."
      }
    ]
  },
  "components": [
    {
      "id": "player",
      "type": "frontend",
      "label": "Video player",
      "sublabel": "<video> + caption DOM",
      "pos": [
        40,
        190
      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "tracks",
      "type": "backend",
      "label": "textTracks source",
      "sublabel": "any .vtt player",
      "pos": [
        280,
        90
      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "dom",
      "type": "backend",
      "label": "DOM source",
      "sublabel": "YouTube, Netflix, picked",
      "pos": [
        280,
        190
      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "ocrcap",
      "type": "backend",
      "label": "OCR capture",
      "sublabel": "canvas -> text mask",
      "pos": [
        280,
        290
      ],
      "size": [
        160,
        60
      ],
      "tag": "every 300 ms"
    },
    {
      "id": "emit",
      "type": "backend",
      "label": "Clean + dedupe",
      "sublabel": "emit()",
      "pos": [
        520,
        190
      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "queue",
      "type": "backend",
      "label": "Speech queue",
      "sublabel": "rate fit + ducking",
      "pos": [
        760,
        190
      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "tts",
      "type": "external",
      "label": "speechSynthesis",
      "sublabel": "default + fallback",
      "pos": [
        1000,
        190
      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "storage",
      "type": "database",
      "label": "chrome.storage",
      "sublabel": "settings, API keys",
      "pos": [
        1000,
        300
      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "tess",
      "type": "external",
      "label": "Tesseract worker",
      "sublabel": "WASM + vie model",
      "pos": [
        40,
        410
      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "offscreen",
      "type": "backend",
      "label": "offscreen.html",
      "sublabel": "ocr-engine.js",
      "pos": [
        280,
        410
      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "bg",
      "type": "backend",
      "label": "background.js",
      "sublabel": "OCR relay + TTS calls",
      "pos": [
        520,
        410
      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "popup",
      "type": "frontend",
      "label": "Popup + hotkey",
      "sublabel": "Alt+Shift+R",
      "pos": [
        1000,
        410
      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "cloudtts",
      "type": "cloud",
      "label": "Gemini / Azure TTS",
      "sublabel": "optional, API key",
      "pos": [
        520,
        530
      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "vieneu",
      "type": "backend",
      "label": "VieNeu-TTS server",
      "sublabel": "127.0.0.1:8000, no key",
      "pos": [
        760,
        530
      ],
      "size": [
        160,
        60
      ]
    },
    {
      "id": "app",
      "type": "frontend",
      "label": "win-voice-over.app",
      "sublabel": "or start-vieneu.cmd",
      "pos": [
        1000,
        530
      ],
      "size": [
        160,
        60
      ]
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "content.js, inside each video tab",
      "wraps": [
        "tracks",
        "dom",
        "ocrcap",
        "emit",
        "queue"
      ]
    },
    {
      "kind": "region",
      "label": "Extension",
      "wraps": [
        "tess",
        "offscreen",
        "bg",
        "popup"
      ]
    },
    {
      "kind": "region",
      "label": "This computer",
      "wraps": [
        "vieneu",
        "app"
      ]
    }
  ],
  "connections": [
    {
      "id": "cue-change",
      "from": "player",
      "to": "tracks",
      "label": "cuechange",
      "fromSide": "top"
    },
    {
      "id": "caption-mutations",
      "from": "player",
      "to": "dom",
      "label": "mutations",
      "variant": "emphasis"
    },
    {
      "id": "video-frames",
      "from": "player",
      "to": "ocrcap",
      "label": "frames"
    },
    {
      "id": "cue-text",
      "from": "tracks",
      "to": "emit"
    },
    {
      "id": "new-words",
      "from": "dom",
      "to": "emit",
      "variant": "emphasis"
    },
    {
      "id": "ocr-lines",
      "from": "ocrcap",
      "to": "emit"
    },
    {
      "id": "say",
      "from": "emit",
      "to": "queue",
      "variant": "emphasis"
    },
    {
      "id": "speak",
      "from": "queue",
      "to": "tts",
      "label": "speak()",
      "variant": "emphasis"
    },
    {
      "id": "tts-request",
      "from": "queue",
      "to": "bg",
      "label": "sendMessage(tts)",
      "variant": "dashed",
      "toSide": "top"
    },
    {
      "id": "ocr-request",
      "from": "ocrcap",
      "to": "bg",
      "label": "sendMessage(PNG)",
      "toSide": "top"
    },
    {
      "id": "relay",
      "from": "bg",
      "to": "offscreen",
      "label": "relay"
    },
    {
      "id": "recognize",
      "from": "offscreen",
      "to": "tess",
      "label": "recognize"
    },
    {
      "id": "cloud-speech",
      "from": "bg",
      "to": "cloudtts",
      "label": "HTTPS + key",
      "variant": "dashed",
      "labelAt": [
        600,
        500
      ]
    },
    {
      "id": "local-speech",
      "from": "bg",
      "to": "vieneu",
      "label": "HTTP, PCM",
      "variant": "dashed",
      "labelAt": [
        720,
        466
      ]
    },
    {
      "id": "start-server",
      "from": "app",
      "to": "vieneu",
      "label": "starts, stops"
    },
    {
      "id": "save-settings",
      "from": "popup",
      "to": "storage",
      "label": "set"
    },
    {
      "id": "settings-changed",
      "from": "storage",
      "to": "queue",
      "label": "onChanged",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Three sources",
      "items": [
        "textTracks: standard .vtt cues",
        "DOM: YouTube, Netflix or a picked element",
        "OCR: hard subs; on by default for motchill"
      ]
    },
    {
      "dot": "emerald",
      "title": "OCR round trip",
      "items": [
        "Light blobs walled in by a dark outline",
        "Tesseract.js in an offscreen document",
        "Lines under 60% confidence are dropped"
      ]
    },
    {
      "dot": "amber",
      "title": "Speech",
      "items": [
        "Browser voice by default, and the fallback",
        "Gemini or Azure with a key; VieNeu with none",
        "Movie volume ducked while speaking"
      ]
    }
  ]
}
