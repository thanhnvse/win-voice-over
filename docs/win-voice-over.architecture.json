{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Win Voice Over: from subtitles to speech",
    "locale": "en",
    "output": "win-voice-over.html",
    "quality_profile": "showcase",
    "viewBox": [
      1200,
      570
    ],
    "views": [
      {
        "id": "soft-subs",
        "label": "Soft subtitles",
        "focus": [
          "player",
          "tracks",
          "dom",
          "emit",
          "queue",
          "tts"
        ],
        "note": "Text tracks and caption DOM already carry text, so they go straight to the speech queue."
      },
      {
        "id": "ocr-path",
        "label": "OCR for hard subtitles",
        "focus": [
          "player",
          "ocrcap",
          "bg",
          "offscreen",
          "tess",
          "emit"
        ],
        "note": "Frames become a text mask in the tab; Tesseract runs in the offscreen document and the lines come back as the reply."
      },
      {
        "id": "settings",
        "label": "Settings",
        "focus": [
          "popup",
          "storage",
          "queue"
        ],
        "note": "Popup and hotkey only write storage; every content script reacts to the change."
      },
      {
        "id": "voices",
        "label": "Voices",
        "focus": [
          "queue",
          "tts",
          "gemini",
          "popup",
          "storage"
        ],
        "note": "Browser voice by default; with a key, Gemini TTS through background.js. A failed Gemini line falls back to the browser voice."
      }
    ]
  },
  "components": [
    {
