{
  "manifest_version": 3,
  "name": "Win Voice Over",
  "version": "0.4.0",
  "description": "Reads subtitles aloud with text-to-speech while you watch, including subtitles burned into the picture.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "offscreen"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Win Voice Over",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "toggle-reading": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Turn subtitle reading on or off"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
